# Optional SQLite file path. Relative paths resolve from the working directory.
# Without this variable, the app uses data/lab.db under the repository root.
DATABASE_PATH=./data/lab.db

# Console traces work without a Collector. Supported modes: console, otlp, none.
OTEL_SERVICE_NAME=cloud-observability-lab
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=local
OTEL_TRACES_EXPORTER=console
OTEL_TRACES_SAMPLER=parentbased_always_on

# Used by either signal in otlp mode. HTTP/protobuf is the supported transport.
# The generic endpoint gets /v1/traces or /v1/metrics appended automatically.
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_TIMEOUT=5

# Use stable HTTP attributes such as http.request.method and http.response.status_code.
OTEL_SEMCONV_STABILITY_OPT_IN=http
# Batch delay in milliseconds; shorter here to make console demos responsive.
OTEL_BSP_SCHEDULE_DELAY=1000

# Metrics are independent of trace sampling. Supported modes: console, otlp, none.
OTEL_METRICS_EXPORTER=console
# Milliseconds; the SDK default is 60000 if this variable is not exported.
OTEL_METRIC_EXPORT_INTERVAL=5000
OTEL_METRIC_EXPORT_TIMEOUT=5000
